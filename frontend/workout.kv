<WorkoutScreen>:
    name: "workout"
    canvas.before:
        Color:
            rgba: .11, .13, .20, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [18, 22, 18, 16]
        spacing: 12

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            Label:
                text: 'Тренировка'
                font_size: '25sp'
                bold: True
                color: .96, .97, .98, 1
                halign: 'left'
                text_size: self.size
            Label:
                text: 'СИЛА'
                font_size: '12sp'
                color: .42, .78, .62, 1
                bold: True
                size_hint_x: .25

        Label:
            text: 'Добавляйте каждый выполненный подход — статистика обновится сразу.'
            color: .65, .68, .76, 1
            font_size: '13sp'
            size_hint_y: None
            height: '32dp'
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Spinner:
            text: root.workout_mode
            values: ['Подходы', 'По времени', 'Тип тренировки']
            option_cls: 'SpinnerOption'
            size_hint_y: None
            height: '44dp'
            background_normal: ''
            background_color: .25, .29, .42, 1
            color: .96, .97, .98, 1
            on_text: root.workout_mode = self.text

        BoxLayout:
            size_hint_y: None
            height: '112dp' if root.workout_mode == 'По времени' else 0
            opacity: 1 if root.workout_mode == 'По времени' else 0
            spacing: 10
            Card:
                orientation: 'vertical'
                padding: [12, 8]
                Label:
                    text: 'ДЛИТЕЛЬНОСТЬ'
                    color: .52, .57, .68, 1
                    font_size: '11sp'
                Label:
                    text: '{} мин'.format(int(root.timed_duration))
                    color: .96, .97, .98, 1
                    font_size: '29sp'
                    bold: True
                BoxLayout:
                    size_hint_y: None
                    height: '30dp'
                    Button:
                        text: '− 10'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_duration(-10)
                    Button:
                        text: '+ 10'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_duration(10)
            Card:
                orientation: 'vertical'
                padding: [12, 8]
                Label:
                    text: 'НАГРУЗКА'
                    color: .52, .57, .68, 1
                    font_size: '11sp'
                Spinner:
                    text: root.intensity
                    values: ['Низкая нагрузка', 'Средняя нагрузка', 'Интенсивная нагрузка']
                    option_cls: 'SpinnerOption'
                    background_normal: ''
                    background_color: .25, .29, .42, 1
                    color: .96, .97, .98, 1
                    font_size: '13sp'
                    on_text: root.intensity = self.text; root.update_calories()
                Label:
                    text: root.calories_text
                    color: .42, .78, .62, 1
                    font_size: '17sp'
                    bold: True

        Card:
            orientation: 'vertical'
            size_hint_y: None
            height: '92dp' if root.workout_mode == 'Тип тренировки' else 0
            opacity: 1 if root.workout_mode == 'Тип тренировки' else 0
            padding: [16, 10]
            Label:
                text: 'ТИП ТРЕНИРОВКИ'
                color: .52, .57, .68, 1
                font_size: '11sp'
                halign: 'left'
                text_size: self.size
            Spinner:
                text: root.training_type
                values: ['Силовая', 'Кардио', 'Мобилити', 'Йога и растяжка']
                option_cls: 'SpinnerOption'
                background_normal: ''
                background_color: .25, .29, .42, 1
                color: .96, .97, .98, 1
                on_text: root.training_type = self.text

        Card:
            orientation: 'vertical'
            size_hint_y: None
            height: '112dp' if root.workout_mode == 'Подходы' else 0
            opacity: 1 if root.workout_mode == 'Подходы' else 0
            padding: [16, 14]
            spacing: 5
            canvas.before:
                Color:
                    rgba: .18, .21, .31, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16,]
            Label:
                text: 'УПРАЖНЕНИЕ'
                color: .52, .57, .68, 1
                font_size: '11sp'
                bold: True
                halign: 'left'
                text_size: self.size
            Spinner:
                text: root.exercise_name
                values: ['Приседания со штангой', 'Жим лёжа', 'Становая тяга', 'Тяга в наклоне', 'Жим гантелей']
                background_normal: ''
                background_color: .25, .29, .42, 1
                color: .96, .97, .98, 1
                font_size: '18sp'
                on_text: root.exercise_name = self.text

        BoxLayout:
            size_hint_y: None
            height: '118dp' if root.workout_mode == 'Подходы' else 0
            opacity: 1 if root.workout_mode == 'Подходы' else 0
            spacing: 12
            Card:
                orientation: 'vertical'
                padding: [12, 10]
                canvas.before:
                    Color:
                        rgba: .18, .21, .31, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16,]
                Label:
                    text: 'ВЕС, КГ'
                    color: .52, .57, .68, 1
                    font_size: '11sp'
                Label:
                    text: str(int(root.set_weight))
                    color: .96, .97, .98, 1
                    font_size: '35sp'
                    bold: True
                BoxLayout:
                    size_hint_y: None
                    height: '32dp'
                    spacing: 8
                    Button:
                        text: '−'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_weight(-2.5)
                    Button:
                        text: '+'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_weight(2.5)
            Card:
                orientation: 'vertical'
                padding: [12, 10]
                canvas.before:
                    Color:
                        rgba: .18, .21, .31, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16,]
                Label:
                    text: 'ПОВТОРЕНИЯ'
                    color: .52, .57, .68, 1
                    font_size: '11sp'
                Label:
                    text: str(int(root.set_reps))
                    color: .96, .97, .98, 1
                    font_size: '35sp'
                    bold: True
                BoxLayout:
                    size_hint_y: None
                    height: '32dp'
                    spacing: 8
                    Button:
                        text: '−'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_reps(-1)
                    Button:
                        text: '+'
                        background_color: .25, .29, .42, 1
                        on_release: root.change_reps(1)

        Label:
            text: root.strength_calories_text
            opacity: 1 if root.workout_mode == 'Подходы' else 0
            size_hint_y: None
            height: '22dp' if root.workout_mode == 'Подходы' else 0
            color: .42, .78, .62, 1
            font_size: '15sp'
            bold: True
            halign: 'center'
            text_size: self.size

        Button:
            text: '+  ДОБАВИТЬ ПОДХОД' if root.workout_mode == 'Подходы' else ('НАЧАТЬ ТАЙМЕР' if root.workout_mode == 'По времени' else 'ВЫБРАТЬ ТИП')
            bold: True
            font_size: '16sp'
            size_hint_y: None
            height: '54dp'
            background_color: .18, .62, .43, 1
            on_release: root.submit_workout()

        Label:
            text: root.set_summary
            color: .70, .74, .82, 1
            size_hint_y: None
            height: '23dp'
            halign: 'left'
            text_size: self.size

        RecycleView:
            viewclass: 'Label'
            data: [{'text': '{}  ·  {} кг × {} повт.'.format(item['exercise'], item['weight'], item['reps']), 'color': (.87, .89, .94, 1), 'font_size': '14sp', 'size_hint_y': None, 'height': dp(30)} for item in root.session_sets]
            RecycleBoxLayout:
                default_size: None, dp(30)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

        Widget:

        BoxLayout:
            size_hint_y: None
            height: '52dp'
            spacing: 8
            Button:
                text: 'Тренировка'
                background_color: .18, .62, .43, 1
            Button:
                text: 'Статистика'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('stats')
            Button:
                text: 'Настройки'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('settings')
