<StatsScreen>:
    name: 'stats'
    canvas.before:
        Color:
            rgba: .11, .13, .20, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: [18, 22, 18, 16]
        spacing: 12
        Label:
            text: 'Статистика'
            font_size: '25sp'
            bold: True
            color: .96, .97, .98, 1
            size_hint_y: None
            height: '40dp'
            halign: 'left'
            text_size: self.size
        Label:
            text: 'Неделя в цифрах'
            font_size: '13sp'
            color: .65, .68, .76, 1
            size_hint_y: None
            height: '22dp'
            halign: 'left'
            text_size: self.size
        BoxLayout:
            size_hint_y: None
            height: '92dp'
            spacing: 10
            Card:
                orientation: 'vertical'
                padding: [14, 10]
                canvas.before:
                    Color:
                        rgba: .18, .21, .31, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16,]
                Label:
                    text: 'ВСЕГО ПОДХОДОВ'
                    color: .52, .57, .68, 1
                    font_size: '10sp'
                    halign: 'left'
                    text_size: self.size
                Label:
                    text: root.total_sets_text
                    color: .42, .78, .62, 1
                    font_size: '30sp'
                    bold: True
                    halign: 'left'
                    text_size: self.size
            Card:
                orientation: 'vertical'
                padding: [14, 10]
                canvas.before:
                    Color:
                        rgba: .18, .21, .31, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16,]
                Label:
                    text: 'ЛУЧШИЙ ДЕНЬ'
                    color: .52, .57, .68, 1
                    font_size: '10sp'
                    halign: 'left'
                    text_size: self.size
                Label:
                    text: root.best_day_text
                    color: .96, .97, .98, 1
                    font_size: '30sp'
                    bold: True
                    halign: 'left'
                    text_size: self.size
        Card:
            orientation: 'vertical'
            padding: [16, 14]
            spacing: 6
            canvas.before:
                Color:
                    rgba: .18, .21, .31, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16,]
            Label:
                text: 'АКТИВНОСТЬ ПО ДНЯМ'
                color: .52, .57, .68, 1
                font_size: '11sp'
                size_hint_y: None
                height: '18dp'
                halign: 'left'
                text_size: self.size
            WeekGraph:
                id: week_graph
                values: root.graph_values
                size_hint_y: .62
            BoxLayout:
                size_hint_y: None
                height: '20dp'
                Label:
                    text: 'Пн     Вт     Ср     Чт     Пт     Сб     Вс'
                    color: .65, .68, .76, 1
                    font_size: '11sp'
                    halign: 'center'
                    text_size: self.size
            Label:
                text: 'Цель недели: ' + root.goal_progress_text + '  ·  ' + root.remaining_text
                color: .87, .89, .94, 1
                font_size: '13sp'
                size_hint_y: None
                height: '24dp'
                halign: 'left'
                text_size: self.size
        Button:
            text: 'СБРОСИТЬ НЕДЕЛЮ'
            size_hint_y: None
            height: '45dp'
            background_color: .42, .27, .22, 1
            on_release: root.reset_week()
        Widget:
        BoxLayout:
            size_hint_y: None
            height: '52dp'
            spacing: 8
            Button:
                text: 'Тренировка'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('workout')
            Button:
                text: 'Статистика'
                background_color: .18, .62, .43, 1
            Button:
                text: 'Настройки'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('settings')
