<SettingsScreen>:
    name: 'settings'
    canvas.before:
        Color:
            rgba: .11, .13, .20, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: [18, 22, 18, 16]
        spacing: 12
        Label:
            text: 'Настройки'
            color: .96, .97, .98, 1
            font_size: '25sp'
            bold: True
            size_hint_y: None
            height: '40dp'
            halign: 'left'
            text_size: self.size
        Label:
            text: 'Персональные цели и приложение'
            color: .65, .68, .76, 1
            font_size: '13sp'
            size_hint_y: None
            height: '22dp'
            halign: 'left'
            text_size: self.size
        Card:
            orientation: 'vertical'
            padding: [16, 14]
            spacing: 6
            size_hint_y: None
            height: '148dp'
            canvas.before:
                Color:
                    rgba: .18, .21, .31, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16,]
            Label:
                text: 'НЕДЕЛЬНАЯ ЦЕЛЬ'
                color: .52, .57, .68, 1
                font_size: '11sp'
                size_hint_y: None
                height: '18dp'
                halign: 'left'
                text_size: self.size
            Label:
                text: root.goal_text
                color: .96, .97, .98, 1
                font_size: '24sp'
                bold: True
                size_hint_y: None
                height: '34dp'
                halign: 'left'
                text_size: self.size
            Slider:
                min: 100
                max: 500
                step: 10
                value: root.goal_value
                value_track: True
                value_track_color: .18, .62, .43, 1
                on_value: root.on_goal_change(self.value)
        Card:
            orientation: 'vertical'
            padding: [16, 14]
            spacing: 8
            size_hint_y: None
            height: '126dp'
            canvas.before:
                Color:
                    rgba: .18, .21, .31, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16,]
            Label:
                text: 'ПРЕДПОЧТЕНИЯ'
                color: .52, .57, .68, 1
                font_size: '11sp'
                size_hint_y: None
                height: '18dp'
                halign: 'left'
                text_size: self.size
            BoxLayout:
                spacing: 8
                Button:
                    text: 'Уведомления: ВКЛ' if root.notif_state else 'Уведомления: ВЫКЛ'
                    background_color: (.18, .62, .43, 1) if root.notif_state else (.42, .27, .22, 1)
                    on_release: root.toggle_notifications()
                Button:
                    text: 'Светлая тема' if root.bg_color[0] < .5 else 'Тёмная тема'
                    background_color: .25, .29, .42, 1
                    on_release: root.toggle_theme()
        Button:
            text: 'СОХРАНИТЬ НАСТРОЙКИ'
            size_hint_y: None
            height: '46dp'
            background_color: .18, .62, .43, 1
            on_release: root.save_current_settings()
        Button:
            text: 'СБРОСИТЬ НЕДЕЛЮ'
            size_hint_y: None
            height: '44dp'
            background_color: .42, .27, .22, 1
            on_release: root.reset_week_only()
        Widget:
        BoxLayout:
            size_hint_y: None
            height: '52dp'
            spacing: 8
            Button:
                text: 'Тренировка'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('workout')
            Button:
                text: 'Статистика'
                background_color: .25, .29, .42, 1
                on_release: root.go_to('stats')
            Button:
                text: 'Настройки'
                background_color: .18, .62, .43, 1
